"components: §0."
msgstr ""

#. §0: `«{a}»`
#. §1: `«{b}»`
#. §2: `rcases le_total a b with h | h`
#: Game/Levels/Specification/L05_StrongEnoughToPinItDown.lean:43
msgid "Now split on which of §0 and §1 is larger: §2."
msgstr ""

#. §0: `«{h}» : a ≤ b`
#. §1: `b`
#. §2: `rw [max_eq_right h]`
#. §3: `f «{a}» «{b}» = «{b}»`
#. §4: `«{hcase}»`
#. §5: `«{h1}»`
#. §6: `«{h2}»`
#. §7: `«{h}»`
#. §8: `omega`
#: Game/Levels/Specification/L05_StrongEnoughToPinItDown.lean:45
